# =========================================================================
# ENV-Template — Platzhalter. Echte Werte NUR in .env.local (gitignored)
# =========================================================================
# Anleitung:
#   cp .env.example .env.local
#   Echte Werte NUR in .env.local eintragen (gitignored).
#   Diese Datei enthält ausschließlich Platzhalter und wird committed.
#   Neue Variablen? → immer ZUERST hier mit Platzhalter dokumentieren.
# =========================================================================

# --- App ---
APP_ENV=
# development | staging | production
APP_URL=
# z. B. http://localhost:3000 (lokal) oder https://meinprojekt.de (production)

# --- Datenbank ---
DATABASE_URL=
# z. B. postgres://user:pass@localhost:5432/dbname

# --- Auth / Sessions ---
APP_KEY=
SESSION_SECRET=

# --- Externe APIs (nur befüllen, was das Projekt braucht) ---
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# TAVILY_API_KEY=
# HUNTER_API_KEY=
# DATAFORSEO_USERNAME=
# DATAFORSEO_PASSWORD=

# --- E-Mail / SMTP ---
# MAIL_HOST=
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=

# --- Deployment / CI ---
# COOLIFY_TOKEN=
# VERCEL_TOKEN=
