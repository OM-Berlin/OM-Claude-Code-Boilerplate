# .env.example: nur Namen und Platzhalter, keine echten Werte.
# Diese Datei wird hochgeladen. Echte Werte kommen in .env.local, die Git nie hochlädt.
# einrichten.sh legt .env.local als Kopie dieser Datei an.
# Neue Variable? Zuerst hier mit leerem Wert eintragen, dann in .env.local befüllen.

# --- Beispiel: eine Schnittstelle (API) mit Schlüssel ---
# BEISPIEL_API_URL=
# BEISPIEL_API_KEY=

# --- Beispiel: eigener n8n-Server ---
# N8N_URL=
# N8N_API_KEY=

# --- Beispiel: KI-Anbieter, nur wenn ein eigenes Programm ihn direkt aufruft ---
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
