# .gitignore: Diese Dateien lädt Git nie hoch.
# Wichtigster Teil ist Abschnitt 1: Schlüssel bleiben auf Ihrem Rechner.

# 1) Schlüssel und Zugangsdaten
.env
.env.*
*.env
!.env.example
*.pem
*.key
*.p12
*.pfx
id_rsa
id_ed25519
credentials.json
service-account*.json
client_secret*.json
secrets.json
.npmrc
.netrc

# 2) Persönliche Einstellungen der KI-Werkzeuge
.claude/settings.local.json
.claude/*.local.json
CLAUDE.local.md
.codex/*.local.toml
.codex/*.local.json
.codex/log/
.codex/tmp/
.mcp.local.json
.agents/*
!.agents/skills/
!.agents/skills/**
!.agents/hooks.json

# 3) Ordner mit fremdem oder vertraulichem Material
raw/*
!raw/index.md
brainstorms/private/
brainstorms/sessions/private/
outputs/vertraulich/

# 4) Betriebssystem und Editor
.DS_Store
._*
Thumbs.db
[Dd]esktop.ini
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.obsidian/workspace*.json
.obsidian/cache/
.trash/

# 5) Abhängigkeiten und Bauergebnisse
node_modules/
.next/
dist/
build/
coverage/
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/

# 6) Logs und Zwischendateien
*.log
*.tmp
*.bak
tmp/
