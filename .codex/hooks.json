{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "ROOT=$(git rev-parse --show-toplevel 2>/dev/null || pwd); HANDOFF_AGENT=codex CLAUDE_PROJECT_DIR=\"$ROOT\" bash \"$ROOT/.claude/hooks/list-recent-handoffs.sh\"",
            "commandWindows": "git -c \"alias.om-hook=!HANDOFF_AGENT=codex bash .claude/hooks/list-recent-handoffs.sh\" om-hook",
            "statusMessage": "Offene Übergaben werden gesucht"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "ROOT=$(git rev-parse --show-toplevel 2>/dev/null || pwd); CLAUDE_PROJECT_DIR=\"$ROOT\" bash \"$ROOT/.claude/hooks/block-dangerous-commands.sh\"",
            "commandWindows": "git -c \"alias.om-hook=!HOOK_AUSGABE=json bash .claude/hooks/block-dangerous-commands.sh\" om-hook",
            "statusMessage": "Befehl wird geprüft",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
